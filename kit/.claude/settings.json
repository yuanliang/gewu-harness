{
  "permissions": {
    "allow": [
      "Bash(.harness/gw *)",
      "Bash(node .harness/gw.mjs *)"
    ],
    "ask": [
      "Bash(.harness/gw chore *)",
      "Bash(.harness/gw approve *)",
      "Bash(./.harness/gw chore *)",
      "Bash(./.harness/gw approve *)",
      "Bash(node .harness/gw.mjs chore *)",
      "Bash(node .harness/gw.mjs approve *)",
      "Edit(/.harness/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/skills/gw-*/**)",
      "Edit(/.claude/agents/gw-*)",
      "Edit(/.github/workflows/gw-*)",
      "Edit(/REVIEW.md)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(npm publish)",
      "Bash(npm publish *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/gw.mjs\" hook session-start", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/gw.mjs\" hook pre-tool", "timeout": 15, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/gw.mjs\" hook post-tool", "timeout": 90 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.harness/gw.mjs\" hook stop", "timeout": 30 }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.harness/gw.mjs\" hook statusline"
  }
}
