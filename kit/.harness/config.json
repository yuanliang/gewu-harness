{
  "verify": null,
  "language": "en",
  "workDir": "docs/work",
  "enforce": "strict",
  "gates": "warn",
  "commit": true,
  "timeoutSec": 900,
  "replaySetup": null,
  "postEdit": null,
  "testGlobs": [
    "**/test/**", "**/tests/**", "**/__tests__/**", "**/spec/**", "**/e2e/**", "**/__snapshots__/**",
    "**/*.test.*", "**/*.spec.*", "**/*_test.*", "**/*-test.*", "**/test_*.py", "**/*_spec.rb",
    "**/*Test.*", "**/*Tests.*"
  ],
  "freeGlobs": [
    "**/*.md", "**/*.mdx", "**/*.rst", "**/*.adoc", "docs/**",
    "LICENSE*", ".gitignore", ".gitattributes", ".editorconfig"
  ],
  "guardGlobs": [
    ".harness/**", ".claude/settings.json", ".claude/settings.local.json",
    ".claude/skills/gw-*/**", ".claude/agents/gw-*", ".github/workflows/gw-*", "REVIEW.md"
  ]
}
