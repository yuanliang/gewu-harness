{
  "verify": null,
  "language": "en",
  "hosts": [
    "claude",
    "codex",
    "cursor"
  ],
  "workDir": "docs/work",
  "enforce": "strict",
  "gates": "warn",
  "commit": true,
  "timeoutSec": 900,
  "replaySetup": null,
  "postEdit": null,
  "testGlobs": [
    "**/test/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/spec/**",
    "**/e2e/**",
    "**/__snapshots__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*_test.*",
    "**/*-test.*",
    "**/test_*.py",
    "**/*_spec.rb",
    "**/*Test.*",
    "**/*Tests.*",
    "**/tests.rs"
  ],
  "freeGlobs": [
    "**/*.md",
    "**/*.mdx",
    "**/*.rst",
    "**/*.adoc",
    "docs/**",
    "LICENSE*",
    ".gitignore",
    ".gitattributes",
    ".editorconfig"
  ],
  "guardGlobs": [
    "REVIEW.md"
  ]
}
