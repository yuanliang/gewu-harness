{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "node .harness/gw.mjs hook session-start --host cursor", "timeout": 15 }
    ],
    "preToolUse": [
      { "command": "node .harness/gw.mjs hook pre-tool --host cursor", "matcher": "Write|Delete", "timeout": 15, "failClosed": true }
    ],
    "beforeShellExecution": [
      { "command": "node .harness/gw.mjs hook pre-tool --host cursor", "timeout": 15, "failClosed": true }
    ],
    "stop": [
      { "command": "node .harness/gw.mjs hook stop --host cursor", "timeout": 30 }
    ]
  }
}
